{
  "name": "deku-swarm",
  "type": "module",
  "version": "1.7.0",
  "description": "Queue-based worker pool with retry, cooldown, and job chaining support",
  "readme": "README.md",
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "scripts": {
    "spec": "npx jasmine --config=spec/support/jasmine.json",
    "test": "npx c8 jasmine --config=spec/support/jasmine.json",
    "coverage": "npx c8 --reporter=lcov jasmine --config=spec/support/jasmine.json",
    "lint": "npx eslint lib spec",
    "lint_fix": "npx eslint lib spec --fix",
    "lint_report": "npx eslint . --format html --output-file report/eslint-report.html",
    "report": "npx jscpd lib spec --reporters console,html --output ./report/jscpd"
  },
  "author": "darthjee",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^8.0.0",
    "c8": "11.0.0",
    "eslint": "^8.0.1",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jasmine": "^4.1.3",
    "eslint-plugin-n": "^15.3.0",
    "eslint-plugin-promise": "^6.0.1",
    "eslint-plugin-sort-class-members": "1.22.1",
    "globals": "^16.5.0",
    "jasmine": "^5.0.0",
    "jscpd": "4.0.8"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "extension": [
      ".js"
    ],
    "include": [
      "lib/**/*.js"
    ],
    "exclude": [
      "spec/**",
      "coverage/**",
      "report/**"
    ],
    "all": true,
    "check-coverage": false,
    "branches": 80,
    "functions": 80,
    "lines": 80,
    "statements": 80
  }
}
