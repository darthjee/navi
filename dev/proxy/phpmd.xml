<?xml version="1.0"?>
<ruleset name="NaviDevProxy"
    xmlns="http://pmd.sf.net/ruleset/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
>
    <description>
        PHPMD ruleset for the dev proxy's PHP classes (dev/proxy/middlewares).
    </description>

    <!--
        UnusedFormalParameter would otherwise flag the $_attributes parameter of
        build(array $_attributes), which both middleware classes below must keep
        (renamed from $attributes) to satisfy the abstract
        Tent\Middlewares\Middleware::build(array $attributes) signature. PHPMD has
        no per-parameter naming exemption for this rule, so these two files are
        excluded from it here instead of adding a @SuppressWarnings annotation.
    -->
    <exclude-pattern>*/middlewares/DelayMiddleware.php</exclude-pattern>
    <exclude-pattern>*/middlewares/RandomFailureMiddleware.php</exclude-pattern>

    <rule ref="rulesets/unusedcode.xml/UnusedFormalParameter"/>
</ruleset>
