{
  "name": "navi-hey-client",
  "type": "module",
  "version": "0.2.0",
  "description": "Node.js client for Navi's token-secured /api/* HTTP namespace",
  "readme": "README.md",
  "main": "client.js",
  "bin": {
    "navi-client": "bin/navi-client.js"
  },
  "files": [
    "bin",
    "lib",
    "client.js"
  ],
  "scripts": {
    "spec": "npx jasmine",
    "test": "npx c8 jasmine --config=spec/support/jasmine.json",
    "coverage": "npx c8 --reporter=lcov jasmine --config=spec/support/jasmine.json",
    "lint": "eslint client.js lib bin spec",
    "lint_fix": "eslint client.js lib bin spec --fix",
    "lint_report": "eslint . --format html --output-file report/eslint-report.html",
    "report": "jscpd client.js lib bin spec --reporters console,html --output ./report/jscpd"
  },
  "author": "darthjee",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^8.0.0",
    "c8": "11.0.0",
    "eslint": "^8.0.1",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jasmine": "^4.1.3",
    "eslint-plugin-n": "^15.3.0",
    "eslint-plugin-promise": "^6.0.1",
    "eslint-plugin-sort-class-members": "1.22.1",
    "globals": "^16.5.0",
    "jasmine": "^5.0.0",
    "jscpd": "4.0.8"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "extension": [
      ".js"
    ],
    "include": [
      "client.js",
      "lib/**/*.js"
    ],
    "exclude": [
      "spec/**",
      "coverage/**",
      "report/**"
    ],
    "all": true,
    "check-coverage": false,
    "branches": 80,
    "functions": 80,
    "lines": 80,
    "statements": 80
  }
}
